# Copy to .env.local (never commit it). n8n reads these when it starts.
ODOO_URL=http://odoo:8069
# Where people open Odoo in the browser; used for the "open in Odoo" links in the approval mails.
ODOO_PUBLIC_URL=http://localhost:8069
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# Only the key for the AI provider you choose in the settings is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
AZURE_OPENAI_API_KEY=
LLM_API_KEY=
